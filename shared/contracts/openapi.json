{
  "openapi": "3.1.0",
  "info": {
    "title": "Concierge Career API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/overview": {
      "get": {
        "summary": "Overview",
        "operationId": "overview_api_v1_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Match": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "matched": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "score",
          "matched",
          "missing",
          "explanation"
        ],
        "title": "Match"
      },
      "NextAction": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "skill": {
            "type": "string",
            "title": "Skill"
          }
        },
        "type": "object",
        "required": [
          "title",
          "reason",
          "skill"
        ],
        "title": "NextAction"
      },
      "Overview": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "database"
            ],
            "title": "Mode"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "goal": {
            "type": "string",
            "title": "Goal"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "next_action": {
            "$ref": "#/components/schemas/NextAction"
          },
          "match": {
            "$ref": "#/components/schemas/Match"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "name",
          "goal",
          "skills",
          "next_action",
          "match"
        ],
        "title": "Overview"
      }
    }
  }
}
