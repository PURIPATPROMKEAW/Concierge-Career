# Local development only. Copy to .env and choose a database password.
POSTGRES_DB=concierge
POSTGRES_USER=concierge
POSTGRES_PASSWORD=replace-with-local-password
DATA_MODE=demo
AI_PROVIDER=mock
DATABASE_URL=postgresql+psycopg://concierge:replace-with-local-password@localhost:5432/concierge
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_URL=http://localhost:8000
